<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download The HaRT Guidebook</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            /* Using a dark blue/safety theme */
            background-color: #f7f9fb;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">

<div id="app" class="w-full max-w-lg bg-white shadow-2xl rounded-xl p-8 md:p-10 border-t-4 border-green-600">
    <header class="text-center mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
            Unlock the HaRT System
        </h1>
        <p class="text-xl font-semibold text-green-600">
            A Leader's Playbook for Cultural Transformation
        </p>
    </header>

    <div class="space-y-6">
        <p class="text-gray-700 text-base">
            Thank you for reading the LinkedIn article! Get the full, complimentary **15-page Guidebook** instantly. This resource includes:
        </p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 pl-4 text-sm">
            <li class="font-medium text-gray-800">The full **Zero-Question Purchasing** Protocol.</li>
            <li class="font-medium text-gray-800">The **Champion Rotation Strategy** for sustainability.</li>
            <li class="font-medium text-gray-800">The complete **HaRT RCA Training Guide** (Section IV).</li>
            <li class="font-medium text-gray-800">The full **60% Incident Reduction** case study data.</li>
        </ul>
    </div>

    <form id="downloadForm" class="mt-8 space-y-4">
        <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
            <input type="text" id="name" name="name" required
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-green-500 focus:border-green-500 transition duration-150 ease-in-out"
                   placeholder="Mehtap Nicolaou">
        </div>
        <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Work Email</label>
            <input type="email" id="email" name="email" required
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-green-500 focus:border-green-500 transition duration-150 ease-in-out"
                   placeholder="your.email@company.com">
        </div>

        <button type="submit"
                class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow-md text-base font-semibold text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-200 ease-in-out transform hover:scale-[1.01] active:scale-95">
            Download the Free Guidebook Instantly
        </button>
    </form>
    
    <div id="message" class="mt-4 text-center text-sm font-medium text-gray-600 hidden">
        Thank you! Your download should start immediately.
    </div>

</div>

<script>
    // CRITICAL: PASTE YOUR GUIDEBOOK PDF LINK HERE
    // You must change this placeholder URL to the actual link of your PDF hosted on Google Drive, Dropbox, etc.
    const GUIDEBOOK_PDF_URL = "https://example.com/link-to-your-hart-guidebook.pdf"; 

    // **NOTE: This form is a simulated lead magnet.**
    // In a live environment (like Mailchimp or a website), the form data would be sent to a database first.
    // For this simple, self-contained file, we simulate the submission and then trigger the download/redirect.

    document.getElementById('downloadForm').addEventListener('submit', function(event) {
        event.preventDefault(); // Stop the default form submission

        const form = event.target;
        const name = form.name.value.trim();
        const email = form.email.value.trim();
        const messageBox = document.getElementById('message');

        if (!name || !email) {
            messageBox.textContent = "Please fill in both name and email.";
            messageBox.classList.remove('hidden', 'text-gray-600');
            messageBox.classList.add('text-red-500');
            return;
        }

        // 1. SIMULATE DATA CAPTURE (In a real scenario, an API call would happen here)
        console.log(`Lead Captured: Name: ${name}, Email: ${email}`);
        
        // You would typically send this data to a CRM/Email list here.
        
        // 2. SHOW CONFIRMATION MESSAGE
        messageBox.textContent = "Thank you! Your download should start immediately.";
        messageBox.classList.remove('hidden', 'text-red-500');
        messageBox.classList.add('text-gray-600');
        
        // 3. TRIGGER DOWNLOAD/REDIRECT
        // This opens the PDF link in the current window, effectively starting the download.
        // It's the most reliable way to deliver the file.
        window.location.href = GUIDEBOOK_PDF_URL;

        // Optionally disable the button after submission
        document.querySelector('button[type="submit"]').disabled = true;
    });
</script>

</body>
</html>
